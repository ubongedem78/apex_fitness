NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=your_super_secret_access_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_min_32_chars

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# Email (SMTP)
SMTP_HOST=test_host
SMTP_PORT=test_port
SMTP_SECURE=false
SMTP_USER=your@test.com
SMTP_PASS=test_password
FROM_EMAIL=noreply@test.ng
FROM_NAME=test
ADMIN_EMAIL=admin@apexfitness.ng

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=apex-avatars

# Seed accounts (optional)
SEED_ADMIN_PASSWORD=
SEED_RECEPTIONIST_PASSWORD=
